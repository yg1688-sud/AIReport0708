{
  "ConnectionStrings": {
    "Default": "Data Source=Data/app.db"
  },
  "Jwt": {
    "Issuer": "AIExport",
    "Audience": "AIExport",
    "ExpiryHours": 2,
    "Secret":""
  },
  "Upload": {
    "MaxFileSize": 104857600,
    "MaxTotalSize": 524288000,
    "MaxFileCount": 20,
    "AllowedFormats": [".xlsx", ".xls", ".csv"]
  },
  "Report": {
    "RetentionDays": 7,
    "MaxConcurrentJobs": 100,
    "RegularRowLimit": 10000,
    "RegularColumnLimit": 50,
    "MaxRows": 1000000,
    "MaxColumns": 200,
    "ProgressIntervalSeconds": 2
  },
  "Chat": {
    "SessionTimeoutMinutes": 30,
    "LlmTimeoutSeconds": 30,
    "LlmFallbackThreshold": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ADMIN_PASSWORD":"",
  "DEEPSEEK_API_KEY":"",
  "KIMI_API_KEY":""
}
